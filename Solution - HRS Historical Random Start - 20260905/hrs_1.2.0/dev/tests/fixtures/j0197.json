{
  "schemaVersion": 1,
  "description": "Pure decision fixtures. They do not claim game-runtime behavior.",
  "defaults": {
    "Phase": "Core",
    "BuildCompatible": true,
    "TargetMatched": true,
    "EacState": "Disabled",
    "Activation": "Active",
    "Mode": "Random",
    "Authority": "Server",
    "Lifecycle": "NewGame",
    "EntityResolved": true,
    "DuplicateObserved": false,
    "MarkerState": "Absent",
    "ReservationResult": "Success",
    "SpawnList": "Available",
    "Candidate": "Valid",
    "PlacementResult": "Verified",
    "CompletionResult": "Success"
  },
  "cases": [
    {
      "id": "OBS-001-new-game-is-observed-only",
      "set": { "Phase": "Observation" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "OBS_ELIGIBLE_NEW_CHARACTER", "Eligible": true, "MarkerAfter": "Absent", "ReservationWrites": 0, "SelectionAttempts": 0, "PlacementAttempts": 0, "CompletionWrites": 0, "PositionChanged": false }
    },
    {
      "id": "OBS-002-enter-multiplayer-is-provisional-observation",
      "set": { "Phase": "Observation", "Lifecycle": "EnterMultiplayer" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "OBS_ELIGIBLE_NEW_CHARACTER", "Eligible": true }
    },
    {
      "id": "OBS-003-client-event-is-rejected",
      "set": { "Phase": "Observation", "Authority": "Client" },
      "expected": { "Outcome": "Rejected", "Reason": "OBS_NOT_SERVER", "Eligible": false }
    },
    {
      "id": "OBS-004-loaded-game-is-rejected",
      "set": { "Phase": "Observation", "Lifecycle": "LoadedGame" },
      "expected": { "Outcome": "Rejected", "Reason": "OBS_LIFECYCLE_REJECTED", "Eligible": false }
    },
    {
      "id": "OBS-005-duplicate-is-suppressed",
      "set": { "Phase": "Observation", "DuplicateObserved": true },
      "expected": { "Outcome": "Rejected", "Reason": "OBS_DUPLICATE_SUPPRESSED", "Eligible": false }
    },
    {
      "id": "OBS-006-unresolved-entity-is-rejected",
      "set": { "Phase": "Observation", "EntityResolved": false },
      "expected": { "Outcome": "Rejected", "Reason": "OBS_ENTITY_UNRESOLVED", "Eligible": false }
    },
    {
      "id": "OBS-007-build-mismatch-is-inert",
      "set": { "Phase": "Observation", "BuildCompatible": false },
      "expected": { "Outcome": "Rejected", "Reason": "OBS_BUILD_MISMATCH", "Eligible": false }
    },
    {
      "id": "OBS-008-target-mismatch-is-inert",
      "set": { "Phase": "Observation", "TargetMatched": false },
      "expected": { "Outcome": "Rejected", "Reason": "OBS_TARGET_MISMATCH", "Eligible": false }
    },
    {
      "id": "OBS-009-eac-is-not-an-approved-lane",
      "set": { "Phase": "Observation", "EacState": "Enabled" },
      "expected": { "Outcome": "Rejected", "Reason": "OBS_EAC_NOT_DISABLED", "Eligible": false }
    },
    {
      "id": "CORE-001-bypassed-is-zero-action",
      "set": { "Activation": "Bypassed" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "POLICY_BYPASSED", "Eligible": false, "MarkerAfter": "Absent", "ReservationWrites": 0, "SelectionAttempts": 0, "PlacementAttempts": 0, "CompletionWrites": 0, "PositionChanged": false }
    },
    {
      "id": "CORE-002-standard-is-exact-no-op",
      "set": { "Mode": "Vanilla" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "STANDARD_EXACT_NOOP", "Eligible": false, "MarkerAfter": "Absent", "ReservationWrites": 0, "SelectionAttempts": 0, "PlacementAttempts": 0, "CompletionWrites": 0, "PositionChanged": false }
    },
    {
      "id": "CORE-003-malformed-mode-fails-closed",
      "set": { "Mode": "Malformed" },
      "expected": { "Outcome": "Rejected", "Reason": "POLICY_MODE_INVALID", "Eligible": false }
    },
    {
      "id": "CORE-004-removed-third-mode-is-rejected",
      "set": { "Mode": "Wilderness" },
      "expected": { "Outcome": "Rejected", "Reason": "POLICY_MODE_INVALID", "Eligible": false, "SelectionAttempts": 0, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-005-client-authority-is-rejected",
      "set": { "Authority": "Client" },
      "expected": { "Outcome": "Rejected", "Reason": "AUTHORITY_NOT_SERVER", "Eligible": false }
    },
    {
      "id": "CORE-006-loaded-game-does-not-reroll",
      "set": { "Lifecycle": "LoadedGame" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "LIFECYCLE_NOT_NEW_CHARACTER", "Eligible": false }
    },
    {
      "id": "CORE-007-death-does-not-reroll",
      "set": { "Lifecycle": "Died" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "LIFECYCLE_NOT_NEW_CHARACTER", "Eligible": false }
    },
    {
      "id": "CORE-008-teleport-callback-does-not-reroll",
      "set": { "Lifecycle": "Teleport" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "LIFECYCLE_NOT_NEW_CHARACTER", "Eligible": false }
    },
    {
      "id": "CORE-009-reconnect-does-not-reroll",
      "set": { "Lifecycle": "JoinMultiplayer" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "LIFECYCLE_NOT_NEW_CHARACTER", "Eligible": false }
    },
    {
      "id": "CORE-010-unknown-lifecycle-does-not-reroll",
      "set": { "Lifecycle": "Unknown" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "LIFECYCLE_NOT_NEW_CHARACTER", "Eligible": false }
    },
    {
      "id": "CORE-011-unresolved-entity-fails-closed",
      "set": { "EntityResolved": false },
      "expected": { "Outcome": "Rejected", "Reason": "ENTITY_UNRESOLVED", "Eligible": false }
    },
    {
      "id": "CORE-012-duplicate-is-suppressed-before-reservation",
      "set": { "DuplicateObserved": true },
      "expected": { "Outcome": "VanillaFallback", "Reason": "DUPLICATE_SUPPRESSED", "Eligible": false, "ReservationWrites": 0, "SelectionAttempts": 0, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-013-marker-api-unavailable-fails-closed",
      "set": { "MarkerState": "Unavailable" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "MARKER_API_UNAVAILABLE", "Eligible": false, "MarkerAfter": "Unavailable" }
    },
    {
      "id": "CORE-014-reserved-marker-is-consumed",
      "set": { "MarkerState": "Reserved" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "MARKER_ALREADY_RESERVED", "Eligible": false, "MarkerAfter": "Reserved", "SelectionAttempts": 0, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-015-completed-marker-is-consumed",
      "set": { "MarkerState": "Completed" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "MARKER_ALREADY_COMPLETED", "Eligible": false, "MarkerAfter": "Completed", "SelectionAttempts": 0, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-016-invalid-marker-is-not-repaired",
      "set": { "MarkerState": "Invalid" },
      "expected": { "Outcome": "Rejected", "Reason": "MARKER_INVALID", "Eligible": false, "MarkerAfter": "Invalid" }
    },
    {
      "id": "CORE-017-malformed-marker-becomes-logically-invalid",
      "set": { "MarkerState": "Malformed" },
      "expected": { "Outcome": "Rejected", "Reason": "MARKER_INVALID", "Eligible": false, "MarkerAfter": "Invalid" }
    },
    {
      "id": "CORE-018-reservation-failure-prevents-selection",
      "set": { "ReservationResult": "Failure" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "RESERVATION_WRITE_FAILED", "Eligible": false, "MarkerAfter": "Absent", "ReservationWrites": 1, "SelectionAttempts": 0, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-019-native-list-unavailable",
      "set": { "SpawnList": "Unavailable" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "SPAWN_LIST_UNAVAILABLE", "Eligible": true, "MarkerAfter": "Reserved", "ReservationWrites": 1, "SelectionAttempts": 0, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-020-native-list-empty",
      "set": { "SpawnList": "Empty" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "SPAWN_LIST_EMPTY", "Eligible": true, "MarkerAfter": "Reserved", "SelectionAttempts": 0, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-021-undefined-candidate",
      "set": { "Candidate": "Undefined" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "CANDIDATE_UNDEFINED", "MarkerAfter": "Reserved", "SelectionAttempts": 1, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-022-invalid-candidate",
      "set": { "Candidate": "Invalid" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "CANDIDATE_INVALID", "MarkerAfter": "Reserved", "SelectionAttempts": 1, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-023-out-of-bounds-candidate",
      "set": { "Candidate": "OutOfBounds" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "CANDIDATE_OUT_OF_BOUNDS", "MarkerAfter": "Reserved", "SelectionAttempts": 1, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-024-unloaded-candidate",
      "set": { "Candidate": "ChunkUnavailable" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "CANDIDATE_CHUNK_UNAVAILABLE", "MarkerAfter": "Reserved", "SelectionAttempts": 1, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-025-unsafe-candidate",
      "set": { "Candidate": "Unsafe" },
      "expected": { "Outcome": "VanillaFallback", "Reason": "CANDIDATE_UNSAFE", "MarkerAfter": "Reserved", "SelectionAttempts": 1, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-026-placement-throw-is-bounded",
      "set": { "PlacementResult": "Throws" },
      "expected": { "Outcome": "Rejected", "Reason": "PLACEMENT_THROW", "MarkerAfter": "Reserved", "SelectionAttempts": 1, "PlacementAttempts": 1, "CompletionWrites": 0, "PositionChanged": false }
    },
    {
      "id": "CORE-027-unverified-placement-is-not-completed",
      "set": { "PlacementResult": "Unverified" },
      "expected": { "Outcome": "Rejected", "Reason": "PLACEMENT_UNVERIFIED", "MarkerAfter": "Reserved", "PlacementAttempts": 1, "CompletionWrites": 0, "PositionChanged": false }
    },
    {
      "id": "CORE-028-completion-write-failure-never-rerolls",
      "set": { "CompletionResult": "Failure" },
      "expected": { "Outcome": "Rejected", "Reason": "COMPLETION_WRITE_FAILED", "MarkerAfter": "Reserved", "ReservationWrites": 1, "SelectionAttempts": 1, "PlacementAttempts": 1, "CompletionWrites": 1, "PositionChanged": true }
    },
    {
      "id": "CORE-029-new-game-success-is-exactly-one",
      "set": {},
      "expected": { "Outcome": "Relocated", "Reason": "CORE_RELOCATION_COMPLETED", "Eligible": true, "MarkerAfter": "Completed", "ReservationWrites": 1, "SelectionAttempts": 1, "PlacementAttempts": 1, "CompletionWrites": 1, "PositionChanged": true }
    },
    {
      "id": "CORE-030-enter-multiplayer-success-is-provisional",
      "set": { "Lifecycle": "EnterMultiplayer" },
      "expected": { "Outcome": "Relocated", "Reason": "CORE_RELOCATION_COMPLETED", "Eligible": true, "MarkerAfter": "Completed", "ReservationWrites": 1, "SelectionAttempts": 1, "PlacementAttempts": 1, "CompletionWrites": 1, "PositionChanged": true }
    },
    {
      "id": "CORE-031-build-mismatch-prevents-all-work",
      "set": { "BuildCompatible": false },
      "expected": { "Outcome": "Rejected", "Reason": "BUILD_MISMATCH", "Eligible": false, "ReservationWrites": 0, "SelectionAttempts": 0, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-032-target-mismatch-prevents-all-work",
      "set": { "TargetMatched": false },
      "expected": { "Outcome": "Rejected", "Reason": "TARGET_MISMATCH", "Eligible": false, "ReservationWrites": 0, "SelectionAttempts": 0, "PlacementAttempts": 0 }
    },
    {
      "id": "CORE-033-eac-prevents-all-work",
      "set": { "EacState": "Enabled" },
      "expected": { "Outcome": "Rejected", "Reason": "EAC_NOT_DISABLED", "Eligible": false, "ReservationWrites": 0, "SelectionAttempts": 0, "PlacementAttempts": 0 }
    }
  ]
}
